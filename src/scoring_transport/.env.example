# Шаблон .env сервиса scoring_transport. Скопируйте в .env и заполните:
#   cp .env.example .env
#
# Внутренний токен парсера для служебных эндпоинтов (POST /score, заголовок
# X-Internal-Token). Значение ОБЯЗАНО совпадать с ZAKUPKI_INTERNAL_TOKEN
# в корневом .env парсера.
TRANSPORT_PARSER_INTERNAL_TOKEN=
