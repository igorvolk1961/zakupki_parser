# Шаблон конфигурации LLM для сервиса скоринга (scoring_service).
#
# Реальные значения положите в файл `.env` (в этой же папке) — он игнорируется git
# и имеет приоритет над config.yaml. Копия: cp .env.example .env
#
# LLM должна быть OpenAI-совместимой. Пример для DeepSeek (OpenAI-совместимый API):
#SCORE_LLM_BASE_URL=https://api.deepseek.com/v1
#SCORE_LLM_API_KEY=sk-...
#SCORE_LLM_MODEL=deepseek-chat

# Значения по умолчанию (совпадают с config.yaml) — можно не указывать в .env:
SCORE_LLM_BASE_URL=https://api.openai.com/v1
SCORE_LLM_API_KEY=sk-dummy
SCORE_LLM_MODEL=gpt-4o-mini

# Внутренний токен парсера (GET /api/clients/active, заголовок X-Internal-Token).
# Значение ОБЯЗАНО совпадать с ZAKUPKI_INTERNAL_TOKEN в корневом .env парсера.
#SCORE_PARSER_INTERNAL_TOKEN=

# Опционально: LangFuse-трассировка (уже подключена к score-csv через build_scorer).
# Заполните и раскомментируйте, чтобы видеть трассировки fit/judge:
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=https://cloud.langfuse.com

# Параллельная ветка векторной близости (Giga Embedder).
# Ключ доступа GigaChat (Sber OAuth): client id/secret. Если не заданы — ветка
# не выполняется, в LangFuse-трейс пишется embedding_skipped="missing giga credentials".
#SCORE_GIGA_ENABLED="true"
#SCORE_GIGA_CLIENT_ID=
#SCORE_GIGA_CLIENT_SECRET=
#SCORE_GIGA_EMBEDDING_ALPHA=0.0
# Giga OAuth (ngw...:9443) использует самоподписанный сертификат — для локальной
# разработки можно отключить проверку SSL: SCORE_GIGA_VERIFY_SSL="false".
#SCORE_GIGA_VERIFY_SSL="true"
