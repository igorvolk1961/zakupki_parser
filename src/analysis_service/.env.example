# Шаблон .env сервиса analysis_service. Скопируйте в .env и заполните:
#   cp .env.example .env
#
# Внутренний токен парсера для чтения активного профиля клиента (заголовок
# X-Internal-Token). Значение ОБЯЗАНО совпадать с ZAKUPKI_INTERNAL_TOKEN
# в корневом .env парсера.
ANALYSIS_PARSER_INTERNAL_TOKEN=

# Каталог промптов вердиктов (markdown-файлы). По умолчанию — каталог prompts
# рядом с модулем; в Docker переопределяется на общий том, куда пишет
# web-интерфейс (вкладка «Промпты»).
# ANALYSIS_PROMPTS_DIR=

# LangFuse-трассировка LLM-вердиктов и эмбеддингов (стандартные переменные,
# как у scoring_service). Без ключей трассировка выключена (no-op).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
