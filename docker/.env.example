# Шаблон секретов Langfuse (self-hosted) для dev-docker.
# Скопируйте в docker/.env и заполните:  cp docker/.env.example docker/.env
# docker/.env игнорируется git — реальные значения не коммитятся.
# Значения подставляются в docker/docker-compose.yml через ${VAR:?...}.

# Профили docker compose. langfuse активен по умолчанию для dev (local `docker compose up`
# поднимает LangFuse). Боевой scripts/compose.sh ставит COMPOSE_PROFILES= (LangFuse не
# поднимается). Отключить при локальном запуске: COMPOSE_PROFILES= docker compose up ...
COMPOSE_PROFILES=langfuse

# LLM для scoring_service (OpenAI-совместимый, напр. DeepSeek)
SCORE_LLM_BASE_URL=https://api.deepseek.com/v1
SCORE_LLM_API_KEY=
SCORE_LLM_MODEL=deepseek-chat

# Стадии каскада скоринга Fit -> P(win) -> Margin. Параметры по умолчанию уже
# зашиты в config.yaml соответствующих сервисов (src/pwin_service, src/margin_service);
# здесь можно переопределить ключевые коэффициенты:
# PWIN_BASE_PWIN=0.4
# MARGIN_MARGIN_RATE=1.0

# PostgreSQL для Langfuse
LANG_PG_USER=langfuse
LANG_PG_PASSWORD=langfuse
LANG_PG_DB=langfuse
LANG_DB_URL=postgresql://langfuse:langfuse@langfuse-db:5432/langfuse

# Криптографические секреты Langfuse (сгенерировать):
#   LANG_SALT=$(openssl rand -hex 16)
#   LANG_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANG_NEXTAUTH_SECRET=$(openssl rand -hex 32)
LANG_SALT=
LANG_ENCRYPTION_KEY=
LANG_NEXTAUTH_SECRET=

# Ключи проекта zakupki (должны совпадать с LANGFUSE_PUBLIC_KEY/SECRET_KEY у scoring-service)
LANG_INIT_PUBLIC_KEY=pk-lf-...
LANG_INIT_SECRET_KEY=sk-lf-...
LANG_ADMIN_PASSWORD=changeme123

# MinIO (объектное хранилище)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
