# Пример файла .env для запуска локально и в Docker.
# Скопируйте в .env и заполните значения:  cp .env.example .env
#
# В Docker секреты автоматически подхватываются из .env через
# env_file: ../.env в docker/docker-compose.yml. Не коммитьте реальные .env.

# --- База данных ---
# DSN PostgreSQL (переопределяет db.dsn в config_service.yaml).
# ZAKUPKI_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/zakupki

# --- Уведомления ---
# Токен Telegram-бота (переопределяет notifications.telegram.token).
# ZAKUPKI_TELEGRAM_TOKEN=
# Числовой id канала Telegram или @username (если не задан в config_service.yaml).
# ZAKUPKI_TELEGRAM_CHAT_ID=

# Токен бота мессенджера MAX (переопределяет notifications.max.token).
# ZAKUPKI_MAX_TOKEN=
# Числовой id канала MAX (если не задан в config_service.yaml).
# ZAKUPKI_MAX_CHAT_ID=

# --- Авторизация API ---
# Авторизация всегда включена (auth.enabled нет; dev-режим закрыт).
# Секрет подписи bearer-токенов — ОБЯЗАТЕЛЕН.
# Сгенерируйте, например: python -c "import secrets; print(secrets.token_hex(32))"
# ZAKUPKI_AUTH_SECRET=
# Внутренний токен служебных эндпоинтов конвейера (POST /score, POST /customers/{id}/rating);
# проверяется по заголовку X-Internal-Token. Одно и то же значение нужно также
# прописать в собственных .env сервисов: src/scoring_transport/.env
# (TRANSPORT_PARSER_INTERNAL_TOKEN) и src/analysis_service/.env
# (ANALYSIS_PARSER_INTERNAL_TOKEN), иначе конвейер не сможет вернуть результат.
# ZAKUPKI_INTERNAL_TOKEN=
# Первый администратор создаётся автоматически при старте API, если таблица
# пользователей пуста и заданы креденшелы:
# ZAKUPKI_ADMIN_USERNAME=administrator
# ZAKUPKI_ADMIN_PASSWORD=

# --- Геопозиционирование (модуль гео-фильтра по расстоянию) ---
# API-ключ облачного сервиса геокодирования (DaData «Подсказки» при provider: dadata).
# В YAML ключ не хранится — читается из этой переменной (config_ops.yaml -> geocoding.key_env).
# При отсутствии ключа гео-фильтр работает в режиме fail-open (закупки не отбрасываются).
# ZAKUPKI_GEO_API_KEY=

# --- analysis_service (RAG-анализ стоп-условий, on-demand) ---
# Внутренний токен парсера для чтения активного профиля клиента (совпадает с
# ZAKUPKI_INTERNAL_TOKEN). Задаётся в собственном .env сервиса:
# src/analysis_service/.env (ANALYSIS_PARSER_INTERNAL_TOKEN).
# ANALYSIS_PARSER_INTERNAL_TOKEN=
# Эмбеддинги: OpenAI-совместимый endpoint (Giga Embedder через gpt2giga-прокси).
# ANALYSIS_EMBEDDING_BASE_URL=http://gpt2giga:8080/v1
# ANALYSIS_EMBEDDING_MODEL=EmbeddingsGigaR
# LLM для вердиктов (сейчас DeepSeek; позже — локальная лёгкая модель).
# ANALYSIS_LLM_BASE_URL=
# ANALYSIS_LLM_MODEL=deepseek-chat
# ANALYSIS_LLM_API_KEY=
# Каталог промптов анализатора (вкладка «Промпты»). В Docker — общий том,
# переопределяется автоматически из docker-compose.yml.
# ZAKUPKI_ANALYSIS_PROMPTS_DIR=

# LLM для api: заполнение профиля (компетенции + лицензии) по сайту поставщика
# (кнопка «Заполнить профиль по URL» вверху редактора профиля). Можно указать
# тот же ключ, что и у ANALYSIS_LLM_API_KEY/SCORE_LLM_API_KEY. Пустой/не заданный
# ключ — функция отключена (эндпоинт отвечает 503).
# ZAKUPKI_PROFILE_LLM_BASE_URL=https://api.deepseek.com/v1
# ZAKUPKI_PROFILE_LLM_MODEL=deepseek-chat
# ZAKUPKI_PROFILE_LLM_API_KEY=

# --- Тарификация LLM и эмбеддингов (app-side, scoring_common/costing.py) ---
# DeepSeek (deepseek-v4-flash/pro): пиковые цены USD/1M вход cache-hit / cache-miss /
# выход указаны в costing.py (пик: 01:00-04:00 и 06:00-10:00 UTC, пн-пт; непик=x0.5).
# Переопределение конкретных цен (USD/1M, ПИК):
# COSTING_DEEPSEEK_FLASH_CACHE_HIT_PEAK=
# COSTING_DEEPSEEK_FLASH_CACHE_MISS_PEAK=
# COSTING_DEEPSEEK_FLASH_OUTPUT_PEAK=
# GigaChat эмбеддинги (EmbeddingsGigaR): руб./1M токенов и курс рубль→доллар.
# COSTING_GIGA_EMBEDDING_RUB_PER_1M=14.0
# COSTING_RUB_TO_USD=90.0
# Yandex Cloud Vision OCR (см. YANDEX_OCR_* выше): руб. за распознанную
# страницу/изображение (тариф модели "page", с НДС, без деления по объёму).
# COSTING_YANDEX_OCR_RUB_PER_PAGE=0.1321

# --- Тесты (интеграционные, требуют поднятый PostgreSQL) ---
# ZAKUPKI_TEST_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/zakupki_test

# --- Объектное хранилище (S3/MinIO, scoring_common.object_storage) —
# ОБЯЗАТЕЛЬНО: API и сервисы indexing/scoring/analysis без него не стартуют.
# Хранит кэш извлечённого текста документов закупки (общий для всех процессов).
# Локально: `docker compose -f docker/docker-compose.yml up -d minio minio-init`
# (поднимет MinIO и создаст бакет); при запуске run_all.sh переменные уйдут во
# все дочерние процессы.
# Порт — host-порт MinIO (LANGFUSE_S3_PORT из docker/.env, по умолчанию 9002).
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9002
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_TZ_CACHE_BUCKET=tz-text-cache
OBJECT_STORAGE_SOURCES_BUCKET=site-sources

# --- OCR для сканов PDF без текстового слоя (scoring_common.ocr) — НЕобязательно.
# Фолбэк ТОЛЬКО когда прямое извлечение текста из PDF не дало результата
# (ни pdfplumber, ни MarkItDown не нашли текстовый слой — весь PDF/его часть
# является сканом). Без настройки — как раньше: такой документ просто не
# читается (best-effort, сервис не падает). Сменяемая модель — как эмбеддинги/
# LLM. OCR_PROVIDER:
#   yandex (по умолчанию) — Yandex Cloud Vision OCR; при отсутствии ключа/
#     folder_id ИЛИ сбое самого запроса (сеть/таймаут/HTTP-ошибка) автоматически
#     подключается локальный tesseract как резервный вариант;
#   tesseract — только локальный OCR, без обращения к Yandex вовсе;
#   none — OCR-фолбэк отключён целиком.
OCR_PROVIDER=yandex
YANDEX_OCR_API_KEY=
YANDEX_OCR_FOLDER_ID=
# Локальный tesseract (фолбэк или OCR_PROVIDER=tesseract) — требует системный
# бинарник tesseract (apt install tesseract-ocr tesseract-ocr-rus для русского).
# Необязательно — значения по умолчанию подходят для большинства случаев.
# TESSERACT_OCR_LANGUAGES=rus+eng
# TESSERACT_OCR_RESOLUTION=200
