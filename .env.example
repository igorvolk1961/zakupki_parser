# Пример файла .env для запуска локально и в Docker.
# Скопируйте в .env и заполните значения:  cp .env.example .env
#
# В Docker секреты автоматически подхватываются из .env через
# env_file: ../.env в docker/docker-compose.yml. Не коммитьте реальные .env.

# --- База данных ---
# DSN PostgreSQL (переопределяет db.dsn в config_service.yaml).
# ZAKUPKI_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/zakupki

# --- Уведомления ---
# Токен Telegram-бота (переопределяет notifications.telegram.token).
# ZAKUPKI_TELEGRAM_TOKEN=
# Числовой id канала Telegram или @username (если не задан в config_service.yaml).
# ZAKUPKI_TELEGRAM_CHAT_ID=

# Токен бота мессенджера MAX (переопределяет notifications.max.token).
# ZAKUPKI_MAX_TOKEN=
# Числовой id канала MAX (если не задан в config_service.yaml).
# ZAKUPKI_MAX_CHAT_ID=

# --- Тесты (интеграционные, требуют поднятый PostgreSQL) ---
# ZAKUPKI_TEST_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/zakupki_test
