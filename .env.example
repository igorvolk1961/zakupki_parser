# Пример файла .env для запуска локально и в Docker.
# Скопируйте в .env и заполните значения:  cp .env.example .env
#
# В Docker секреты автоматически подхватываются из .env через
# env_file: ../.env в docker/docker-compose.yml. Не коммитьте реальные .env.

# --- База данных ---
# DSN PostgreSQL (переопределяет db.dsn в config_service.yaml).
# ZAKUPKI_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/zakupki

# --- Уведомления ---
# Токен Telegram-бота (переопределяет notifications.telegram.token).
# ZAKUPKI_TELEGRAM_TOKEN=
# Числовой id канала Telegram или @username (если не задан в config_service.yaml).
# ZAKUPKI_TELEGRAM_CHAT_ID=

# Токен бота мессенджера MAX (переопределяет notifications.max.token).
# ZAKUPKI_MAX_TOKEN=
# Числовой id канала MAX (если не задан в config_service.yaml).
# ZAKUPKI_MAX_CHAT_ID=

# --- Авторизация API ---
# Включить требование авторизации (переопределяет auth.enabled в config_ops.yaml).
# ZAKUPKI_AUTH_ENABLED=true
# Секрет подписи bearer-токенов (обязателен при включённой авторизации).
# Сгенерируйте, например: python -c "import secrets; print(secrets.token_hex(32))"
# ZAKUPKI_AUTH_SECRET=
# Внутренний токен служебных эндпоинтов конвейера (POST /score, POST /customers/{id}/rating);
# проверяется по заголовку X-Internal-Token. Одно и то же значение нужно также
# прописать в собственных .env сервисов: src/scoring_transport/.env
# (TRANSPORT_PARSER_INTERNAL_TOKEN) и src/analysis_service/.env
# (ANALYSIS_PARSER_INTERNAL_TOKEN), иначе конвейер не сможет вернуть результат.
# ZAKUPKI_INTERNAL_TOKEN=
# Первый администратор создаётся автоматически при старте API, если таблица
# пользователей пуста и заданы креденшелы:
# ZAKUPKI_ADMIN_USERNAME=admin
# ZAKUPKI_ADMIN_PASSWORD=

# --- analysis_service (RAG-анализ стоп-условий, on-demand) ---
# Внутренний токен парсера для чтения активного профиля клиента (совпадает с
# ZAKUPKI_INTERNAL_TOKEN). Задаётся в собственном .env сервиса:
# src/analysis_service/.env (ANALYSIS_PARSER_INTERNAL_TOKEN).
# ANALYSIS_PARSER_INTERNAL_TOKEN=
# Эмбеддинги: OpenAI-совместимый endpoint (Giga Embedder через gpt2giga-прокси).
# ANALYSIS_EMBEDDING_BASE_URL=http://gpt2giga:8080/v1
# ANALYSIS_EMBEDDING_MODEL=EmbeddingsGigaR
# LLM для вердиктов (сейчас DeepSeek; позже — локальная лёгкая модель).
# ANALYSIS_LLM_BASE_URL=
# ANALYSIS_LLM_MODEL=deepseek-chat
# ANALYSIS_LLM_API_KEY=
# Каталог промптов анализатора (вкладка «Промпты»). В Docker — общий том,
# переопределяется автоматически из docker-compose.yml.
# ZAKUPKI_ANALYSIS_PROMPTS_DIR=

# --- Тесты (интеграционные, требуют поднятый PostgreSQL) ---
# ZAKUPKI_TEST_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/zakupki_test
